From 7b3a7d7b8b5563ad0fded9237bdbb5df9aefb4c2 Mon Sep 17 00:00:00 2001
From: Aiden CI <ci@aiden.local>
Date: Fri, 12 Jun 2026 00:00:00 +0000
Subject: [PATCH] util/mkbuildinf: honor SOURCE_DATE_EPOCH=0

OpenSSL 1.1.1 uses Perl truthiness when selecting the build timestamp.
The string "0" is false in Perl, so a valid SOURCE_DATE_EPOCH=0 falls
back to the wall clock and makes libcrypto differ between identical
reproducible builds.

Use definedness instead so every explicit SOURCE_DATE_EPOCH value is
honored.
---
 util/mkbuildinf.pl | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/util/mkbuildinf.pl b/util/mkbuildinf.pl
index 8057bbda31..3a0e9d17e4 100755
--- a/util/mkbuildinf.pl
+++ b/util/mkbuildinf.pl
@@ -12,6 +12,6 @@ use warnings;
 my ($cflags, $platform) = @ARGV;
 $cflags = "compiler: $cflags";
 
-my $date = gmtime($ENV{'SOURCE_DATE_EPOCH'} || time()) . " UTC";
+my $date = gmtime(defined $ENV{'SOURCE_DATE_EPOCH'} ? $ENV{'SOURCE_DATE_EPOCH'} : time()) . " UTC";
 
 print <<"END_OUTPUT";
-- 
2.50.0
