/*
 * Aiden SCH v1 (RV1106G) board device tree
 *
 * Derived from rv1106g-luckfox-pico-zero.dts and
 * rv1106-luckfox-pico-zero-ipc.dtsi and adapted to the Aiden SCH v1
 * hardware (GD32L235 MCU + MP2720 charger + BQ27220 fuel gauge,
 * RK628F/H HDMI-to-CSI bridge on I2C3, SDMMC0 TF card, SKI.WB800
 * WiFi/BT, AW8010 amplifier and ASRPro voice module).
 */

/dts-v1/;
#include "rv1106.dtsi"
#include "rv1106-evb.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/display/media-bus-format.h>

/ {
	model = "Aiden SCH v1";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyFIQ0 root=/dev/mmcblk0p7 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=0";
	};

	restart-poweroff {
		compatible = "restart-poweroff";
	};

	reserved_memory: reserved-memory {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		mmc_ecsd: mmc@3f000 {
			reg = <0x3f000 0x00001000>;
		};
	};

	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rv1106-acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		/* AW8010AFCR Class-D amplifier enable/shutdown (SPK_SDn_1V8). */
		spk-con-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
		status = "okay";
		simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};

	dsm_sound: dsm-sound {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "rockchip,dsm-sound";
		simple-audio-card,bitclock-master = <&sndcodec>;
		simple-audio-card,frame-master = <&sndcodec>;
		sndcpu: simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};
		sndcodec: simple-audio-card,codec {
			sound-dai = <&dsm>;
		};
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vdd_arm: vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1000000>;
		regulator-init-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* TF card supply switch driven by the WS4622C (SDMMC0_PWREN). */
	vcc3v3_sd: vcc3v3-sd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd";
		gpio = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
	};

	/* WiFi (SKI.WB800) 3.3V rail. */
	v_wifi_vcc: v-wifi-vcc {
		compatible = "regulator-fixed";
		regulator-name = "v_wifi_vcc";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	leds: leds {
		compatible = "gpio-leds";
		work_led: work {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "activity";
			default-state = "on";
		};
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		BT,wake_gpio     = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>; /* RV_WAKE_BT_1V8 */
		BT,wake_host_irq = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>; /* BT_WAKE_MCU */
		status = "okay";
	};

	/*
	 * GD32L235 companion MCU interface.
	 *
	 * RV_HOLD keeps VCC5V0_SYS enabled: the MCU forces the rail up at
	 * power-on and cuts it again unless the SoC takes over the signal
	 * within its supervision window.  The kernel drives GPIO0_A3 high
	 * through the gpio-leds default state.
	 */
	mcu_control {
		compatible = "gpio-leds";

		rv_hold {
			label = "rv-hold";
			gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

	/*
	 * RECOVERY shares the GPIO4_C0 / SARADC_IN0 ball.  Pulling it low
	 * while the BootROM samples the pin enters Loader/download mode; at
	 * runtime it is reported as a KEY_VENDOR key event.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		recovery {
			label = "recovery";
			linux,code = <KEY_VENDOR>;
			gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_LOW>;
			debounce-interval = <100>;
		};
	};

	/*
	 * The EVB ADC volume keys are not populated; GPIO4_C0 is used as
	 * RECOVERY instead of as SARADC_IN0.
	 */
	adc-keys {
		status = "disabled";
	};
};

/**********CRU**********/
&cru {
	assigned-clocks =
		<&cru PLL_GPLL>, <&cru PLL_CPLL>,
		<&cru ARMCLK>,
		<&cru ACLK_PERI_ROOT>, <&cru HCLK_PERI_ROOT>,
		<&cru PCLK_PERI_ROOT>, <&cru ACLK_BUS_ROOT>,
		<&cru PCLK_TOP_ROOT>, <&cru PCLK_PMU_ROOT>,
		<&cru HCLK_PMU_ROOT>, <&cru CLK_500M_SRC>;
	assigned-clock-rates =
		<1188000000>, <700000000>,
		<1104000000>,
		<400000000>, <200000000>,
		<100000000>, <300000000>,
		<100000000>, <100000000>,
		<200000000>, <700000000>;
};

/**********NPU**********/
&npu {
	assigned-clock-rates = <700000000>;
};

/**********EMMC**********/
&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	// mmc-hs200-1_8v;
	rockchip,default-sample-phase = <90>;
	no-sdio;
	no-sd;
	memory-region-ecsd = <&mmc_ecsd>;
	post-power-on-delay-ms = <0>;
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

/************************* FIQ_DUBUGGER ****************************/
&fiq_debugger {
	rockchip,irq-mode-enable = <1>;
	status = "okay";
};

/***************************** audio ********************************/
&i2s0_8ch {
	#sound-dai-cells = <0>;
	status = "okay";
};

&acodec {
	#sound-dai-cells = <0>;
	status = "okay";
};

/***************************** DSM *********************************/
&dsm {
	status = "disabled";
};

/***************************** USB *********************************/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	extcon = <&u2phy>;
	status = "okay";
	dr_mode = "peripheral";
};

/**********SDIO-WIFI (SKI.WB800)**********/
&sdio {
	max-frequency = <50000000>;
	bus-width = <4>;
	non-removable;
	cap-sd-highspeed;
	supports-sdio;
	vmmc-supply = <&v_wifi_vcc>; /* WiFi supply */
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_cmd &sdmmc1m0_clk &sdmmc1m0_bus4>;
	status = "okay";
};

/**********SD_CARD / TF (SDMMC0)**********/
&sdmmc {
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	supports-sd;
	disable-wp;
	vmmc-supply = <&vcc3v3_sd>; /* TF card supply */
	cd-gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_LOW>; /* SDMMC_DET */
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4 &sdmmc0_det>;
	status = "okay";
};

&pinctrl {
	sdmmc0 {
		sdmmc0_det: sdmmc0-det {
			rockchip,pins =
				/* sdmmc0_det */
				<3 RK_PA1 1 &pcfg_pull_up>;
		};
	};
};

/**********ETH**********/
&gmac {
	status = "disabled";
};

/**********RTC**********/
&rtc {
	status = "okay";
};

/**********Power management / I2C**********/
&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m1_xfer>;

	mp2720: charger@4b {
		compatible = "mps,mp2720";
		reg = <0x4b>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		status = "okay";
	};

	bq27220: fuel-gauge@55 {
		compatible = "ti,bq27220";
		reg = <0x55>;
		status = "okay";
	};
};

/*************************** CSI *********************************/
&csi2_dphy_hw {
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* RK628F/H HDMI-to-CSI bridge (four lanes). */
			rk628_csi_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&rk628_csi_out>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_output: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&mipi_csi2_input>;
			};
		};
	};
};

/* RK628F/H is mounted on I2C3 (RV_I2C3_SCL_1V8 / SDA_1V8), address 0x50. */
&i2c3 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_xfer>;

	rk628: rk628@50 {
		compatible = "rockchip,rk628-csi-v4l2";
		reg = <0x50>;
		status = "okay";
		continues-clk;
		/* Preserve the HDMI timing on CSI; userspace advertises 1080p60-only EDID. */

		pinctrl-names = "default";
		pinctrl-0 = <&rk628_reset_pin &rk628_int_pin>;
		reset-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>; /* RK628_RESET_H */
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PB1 IRQ_TYPE_LEVEL_HIGH>; /* RK628_INT_H */

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "RK628-CSI";
		rockchip,camera-module-lens-name = "NC";

		port {
			rk628_csi_out: endpoint {
				remote-endpoint = <&rk628_csi_in>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
			};
		};
	};
};

/* The legacy TC358743 bridge and its I2C4 bus are not populated. */
&i2c4 {
	status = "disabled";
};

&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_input: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&csi_dphy_output>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_output: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&cif_mipi_in>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mipi_pins>;
	port {
		/* MIPI CSI-2 endpoint */
		cif_mipi_in: endpoint {
				remote-endpoint = <&mipi_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		/* MIPI CSI-2 endpoint */
		mipi_lvds_sditf: endpoint {
				remote-endpoint = <&isp_in>;
		};
	};
};

&rkisp {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port@0 {
		isp_in: endpoint {
				remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

/***************************** ADC ********************************/
&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&tsadc {
	status = "okay";
};

/**************************** UART ********************************/
/* Bluetooth (SKI.WB800) on UART0 with RTS/CTS hardware flow control. */
&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m1_xfer &uart0m1_ctsn &uart0m1_rtsn>;
};

/* ASRPro offline voice module. */
&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer>;
};

/* Extension UART3. */
&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m1_xfer>;
};

/**************************** SPI *********************************/
&spi0 {
	status = "disabled";
};

/**************************** PINCTRL ******************************/
&pinctrl {
	rk628 {
		rk628_reset_pin: rk628-reset-pin {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		rk628_int_pin: rk628-int-pin {
			rockchip,pins = <1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	/*
	 * UART3 is the GD32L235 LPUART1 link and uses the M1 pin group on
	 * GPIO1_D0/D1.  RV1106 muxes UART3_M1 with function index 5 on these
	 * balls; function 2 selects vicap_clkin_m1/vicap_hsync_m1 (index 2 is
	 * the RV1126 value and does not apply here).
	 */
	uart3 {
		uart3m1_xfer: uart3m1-xfer {
			rockchip,pins =
				/* gpio1_d0 -> UART3_TX_M1 */
				<1 RK_PD0 5 &pcfg_pull_none>,
				/* gpio1_d1 -> UART3_RX_M1 */
				<1 RK_PD1 5 &pcfg_pull_none>;
		};
	};
};
